rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read for hackathon status and timers; write restricted to authenticated admins
    match /hackathon/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Public read for leaderboard & team profiles; write restricted to authenticated admins
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // Public read for live activity ticker; write restricted to authenticated admins
    match /activity/{activityId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
