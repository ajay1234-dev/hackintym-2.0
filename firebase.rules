rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hackathon status & timer configuration
    match /hackathon/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Teams collection:
    // Public read and write enabled so teams can upload profile photos & taglines
    // via the participant portal without requiring administrative login.
    match /teams/{teamId} {
      allow read, write: if true;
    }
    
    // Live activity ticker stream
    match /activity/{activityId} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
